# Copiar para /etc/kidstube/resolver.env e preencher.
# Contém um segredo e o caminho dos cookies: chmod 600, dono root.

# Escuta só em localhost — quem fala com a Internet é o Caddy à frente.
PORT=8478

# Obrigatório. Gerar com: openssl rand -hex 24
KIDTUBE_RESOLVER_TOKEN=

# Não serve a app nem a administração, só as rotas do resolvedor.
KIDTUBE_RESOLVER_ONLY=1

# Restringe o CORS à origem da app publicada.
KIDTUBE_ALLOW_ORIGIN=https://oliverbill.github.io

# Cookies de uma sessão do YouTube com Premium. Sem isto, o IP do VPS leva com o
# "confirma que não és um robô" do YouTube. Ver o README para como os exportar.
KIDTUBE_COOKIES=/etc/kidstube/cookies.txt

# Tecto de qualidade (720 poupa largura de banda se os streams passarem pelo VPS).
KIDTUBE_MAX_HEIGHT=1080
