# Copiar para /etc/kidstube/kidstube.env no VPS. chmod 600, dono root.

# Endereço público — o Google exige que o redirect_uri do OAuth bata certo.
KIDTUBE_PUBLIC_URL=https://kidstube.oliversys.tech

# Atrás do Cloudflare Tunnel: o IP real vem no X-Forwarded-For, e é por IP que o
# limite de resoluções conta.
KIDTUBE_TRUST_PROXY=1

# Resoluções por IP em 10 minutos. Impede que a app pública sirva de
# descarregador de YouTube ao mundo.
KIDTUBE_RESOLVE_RATE=40

# Cookies de uma sessão do YouTube com Premium. Num IP de datacenter isto é o que
# evita o "confirma que não és um robô". Montado read-only pelo compose.
KIDTUBE_COOKIES=/app/secrets/cookies.txt

# Onde fica o refresh_token do Google (volume kidstube-secrets).
KIDTUBE_GOOGLE_STATE=/app/secrets/google-oauth.json

# OAuth da conta do YouTube — os mesmos que estavam nos secrets do Worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reposição do PIN por email ('Esqueci-me do PIN' no painel). Sem isto, o botão
# não aparece e um PIN esquecido só se resolve por SSH.
# No Gmail é preciso uma "palavra-passe de aplicação" (a password normal não serve):
# myaccount.google.com -> Segurança -> Verificação em duas etapas -> Palavras-passe de aplicações
KIDTUBE_RESET_EMAIL=alves.bill@gmail.com
KIDTUBE_SMTP_HOST=smtp.gmail.com
KIDTUBE_SMTP_PORT=465
KIDTUBE_SMTP_USER=alves.bill@gmail.com
KIDTUBE_SMTP_PASS=

# Tecto de qualidade. Baixar para 480 se o tráfego pelo VPS pesar.
KIDTUBE_MAX_HEIGHT=1080
